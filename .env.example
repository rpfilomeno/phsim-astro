# Google Gemini API keys (comma-separated for rotation)
GEMINIKEYS=your-gemini-key-1,your-gemini-key-2

# Firecrawl API key
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# NASA API key (free at https://api.nasa.gov)
NASA_API_KEY=your-nasa-key

#Target repo
DEPLOY_REPO=rpfilomeno/phsim-static

#Fine-grained PAT
GITHUB_TOKEN=your-pat-for-target-repo

#sleep-loop — after pushing
PUSH_INTERVAL_HOURS=24