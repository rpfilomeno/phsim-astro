---
import '../styles/global.css';
import RealmHeader from '../components/RealmHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Midgarts PH: The Pearl Archipelago - Republic Server Patch & Maintenance Registry',
  description = 'Satirical Ragnarok-style patch notes, server status bulletins, and GM logs for the Philippine Republic Server Ver 7107.25. A parody fan project.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09436b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@600;700&family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Botpress webchat: loader first, bot config second; defer keeps order and delays both until parsed -->
    <script
      is:inline
      defer
      src="https://cdn.botpress.cloud/webchat/v3.7/inject.js"></script>
    <script
      is:inline
      defer
      src="https://files.bpcontent.cloud/2025/01/25/00/20250125005609-7G1UEWJF.js"></script>
  </head>
  <body
    class="bg-surface font-body-md text-on-surface antialiased selection:bg-secondary selection:text-on-secondary"
  >
    <RealmHeader />
    <main id="main" class="w-full bg-surface min-h-[calc(100vh-140px)]">
      <div class="max-w-[1280px] mx-auto px-gutter md:px-gutter-desktop py-space-lg">
        <slot />
      </div>
    </main>
    <SiteFooter />
    <script>
      // Recolor the Botpress webchat (shadow DOM on #fab-root) to the site palette:
      // navy primary #09436b with the gold accent #ffe088 on the bubble icon.
      const BP_THEME = `
        .bpReset {
          --bpPrimary-50: #ffe088;
          --bpPrimary-100: #fed65b;
          --bpPrimary-200: #c7d9e4;
          --bpPrimary-300: #a1bfd1;
          --bpPrimary-400: #6d97b1;
          --bpPrimary-500: #2b5b84;
          --bpPrimary-600: #09436b;
          --bpPrimary-700: #073654;
          --bpPrimary-800: #052940;
          --bpPrimary-900: #041d2f;
          --bpPrimary-950: #02121d;
        }
      `;
      const applyBpTheme = () => {
        const root = document.getElementById('fab-root')?.shadowRoot;
        if (!root || root.getElementById('bp-site-theme')) return;
        const style = document.createElement('style');
        style.id = 'bp-site-theme';
        style.textContent = BP_THEME;
        root.appendChild(style);
      };
      // The widget mounts lazily and may re-render, so keep re-applying on DOM changes.
      applyBpTheme();
      new MutationObserver(applyBpTheme).observe(document.body, { childList: true, subtree: true });
    </script>
  </body>
</html>
